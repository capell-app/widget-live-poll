{
    "manifest-version": 3,
    "name": "capell-app/widget-live-poll",
    "slug": "widget-live-poll",
    "displayName": "Live Poll Widget",
    "kind": "package",
    "capellApiVersion": "^1.0",
    "version": "1.0.0",
    "description": "One multiple-choice question on a page, one vote per browser, with totals shown when you choose.",
    "product": {
        "group": "Capell Essentials",
        "tier": "free",
        "bundle": "foundation"
    },
    "namespace": "Capell\\WidgetLivePoll",
    "surfaces": ["admin", "frontend", "console"],
    "dependencies": {
        "requires": [
            "capell-app/admin",
            "capell-app/core",
            "capell-app/frontend",
            "capell-app/layout-builder"
        ],
        "supports": [],
        "conflicts": []
    },
    "providers": {
        "metadata": [
            "Capell\\WidgetLivePoll\\Providers\\MigrationMetadataServiceProvider"
        ],
        "install": [],
        "runtime": [
            "Capell\\WidgetLivePoll\\Providers\\WidgetLivePollServiceProvider"
        ],
        "admin": [],
        "frontend": []
    },
    "contributes": [
        {
            "type": "content-widget",
            "key": "capell-app.live-poll",
            "class": "Capell\\WidgetLivePoll\\WidgetLivePollContribution"
        },
        {
            "type": "scheduled-job",
            "class": "Capell\\WidgetLivePoll\\Manifest\\LivePollPruneScheduleContribution",
            "command": "capell:polls:prune-voters",
            "frequency": "daily"
        },
        {
            "type": "migration",
            "class": "Capell\\WidgetLivePoll\\Manifest\\WidgetLivePollMigrationsContribution",
            "migrationFiles": [
                "2026_07_09_000001_create_capell_polls_table",
                "2026_07_09_000002_create_capell_poll_options_table",
                "2026_07_09_000003_create_capell_poll_votes_table",
                "2026_10_04_000001_remove_implicit_timestamp_updates_from_widget_live_poll"
            ]
        },
        {
            "type": "asset",
            "key": "resource-group:capell-app.widget-live-poll",
            "class": "Capell\\WidgetLivePoll\\WidgetLivePollContribution"
        }
    ],
    "database": {
        "migrations": true,
        "settings": false,
        "requiredTables": [
            "capell_polls",
            "capell_poll_options",
            "capell_poll_votes"
        ]
    },
    "commands": {
        "install": null,
        "setup": null,
        "setupParams": [],
        "demo": null,
        "doctor": null
    },
    "settings": [],
    "permissions": [],
    "capabilities": ["frontend-surface"],
    "security": {
        "riskTier": "standard",
        "publicSurface": {
            "routeNames": [
                "GET /_capell/widget-polls/{reference}/bootstrap (capell.widget-live-poll.bootstrap)",
                "GET /_capell/widget-polls/{reference}/results (capell.widget-live-poll.results)",
                "POST /_capell/widget-polls/{reference}/vote (capell.widget-live-poll.vote)"
            ],
            "auth": "public",
            "csrfExemptRoutes": [],
            "signedRoutes": [],
            "tokenizedRoutes": [],
            "webhookRoutes": [],
            "throttledRoutes": [
                "GET /_capell/widget-polls/{reference}/bootstrap (capell.widget-live-poll.bootstrap)",
                "GET /_capell/widget-polls/{reference}/results (capell.widget-live-poll.results)",
                "POST /_capell/widget-polls/{reference}/vote (capell.widget-live-poll.vote)"
            ]
        },
        "sensitiveData": {
            "encryptedFields": [],
            "hashedTokenFields": ["capell_poll_votes.voter_hash"],
            "redactedOutputClasses": [],
            "plaintextJustifications": []
        },
        "publicOutput": {
            "cacheSafe": true,
            "forbidAuthoringSurface": true,
            "forbidSecrets": true,
            "forbidPublicBladeQueries": true
        },
        "externalHttpClients": {
            "requiresTimeouts": false,
            "requiresSecretRedaction": false,
            "clients": []
        },
        "adminSurface": {
            "authorization": "panel-auth",
            "permissions": []
        }
    },
    "performance": {
        "frontendRenderBudgetMs": 15,
        "adminQueryBudget": 3,
        "cacheTags": ["widget-live-poll"],
        "cacheSafety": {
            "cacheable": false,
            "variesBy": ["site", "locale", "theme"],
            "sensitiveOutput": false,
            "invalidationSources": [
                {
                    "model": "Capell\\Core\\Models\\Page",
                    "events": [
                        "created",
                        "updated",
                        "deleted",
                        "restored",
                        "forceDeleted"
                    ]
                },
                {
                    "model": "Capell\\WidgetLivePoll\\Models\\Poll",
                    "events": ["created", "updated", "deleted"]
                },
                {
                    "model": "Capell\\WidgetLivePoll\\Models\\PollOption",
                    "events": ["created", "updated", "deleted"]
                }
            ],
            "queueInvalidation": false
        }
    },
    "healthChecks": [
        {
            "key": "widget-live-poll.package-health",
            "label": "Live Poll widget package health",
            "class": "Capell\\WidgetLivePoll\\Health\\WidgetLivePollHealthCheck",
            "severity": "critical",
            "surface": "frontend"
        }
    ],
    "commercial": {
        "proposedLicense": "free",
        "requestedCertification": "first-party",
        "supportPolicy": "capell-first-party",
        "privateDocsRequested": false
    },
    "marketplace": {
        "summary": "A poll with one question and up to ten answers, showing vote counts always, after voting or after closing.",
        "description": "Ask visitors one question with up to ten answers and let them vote with a single press. You decide when totals show up, either from the start, after someone votes, or once the poll closes on a date you pick. Totals are plain counts that refresh when the page loads or a vote comes in. Each browser gets one vote, kept track of with one cookie, and the site stores only a scrambled copy with no internet address. Voter records are deleted ninety days after closing and the totals stay. It needs Layout Builder to place it on a page.",
        "problem": "Site owners want a quick show of hands without a full form or people voting over and over.",
        "outcome": "Visitors vote in one click and see plain totals at the moment you chose.",
        "faq": [
            {
                "question": "Who sees the results?",
                "answer": "You decide when. Results can show for everyone straight away, only for people who have voted, or only once the poll closes on a date you set."
            },
            {
                "question": "Can someone vote twice?",
                "answer": "Each browser gets one vote per poll. Someone with a second phone could vote again, so it suits a friendly poll and should not be used as a formal ballot."
            },
            {
                "question": "Does the poll store personal information?",
                "answer": "It sets one cookie to remember a visitor's vote, and your site holds just a scrambled version of it with the vote. To cap votes, a scrambled form of the internet address is held for a day, and the address itself is not saved."
            },
            {
                "question": "What happens to voter records after a poll closes?",
                "answer": "If the poll has a closing date, the records of who voted are removed 90 days after it. The totals are kept."
            },
            {
                "question": "How many answers can a poll have?",
                "answer": "Up to ten. Results are plain counts for each answer, without percentages or bars."
            }
        ],
        "screenshots": [
            {
                "path": "docs/assets/marketplace/listing-live-poll-public-output.png",
                "alt": "Poll with three radio options, a Vote button and a Results list that shows zero for each answer",
                "caption": "Visitors choose one answer and press Vote, with the totals listed underneath."
            },
            {
                "path": "docs/assets/marketplace/listing-live-poll-layout-builder-editor.png",
                "alt": "Page editor with a Live Poll block open, showing the question, three option labels and an Add to options button",
                "caption": "Write the question, then add each answer as its own option."
            },
            {
                "path": "docs/assets/marketplace/extension-card.jpg",
                "alt": "Marketplace card for the Live Poll widget with a poll page and an editor screen and the steps Install, Use and Evolve",
                "caption": "Card used for the widget's Marketplace listing."
            }
        ],
        "categories": ["foundation", "frontend", "interactive"]
    },
    "contributionTraceability": {
        "contributions": [
            {
                "type": "asset",
                "key": "resource-group:capell-app.widget-live-poll",
                "providerBucket": "runtime"
            },
            {
                "type": "content-widget",
                "key": "capell-app.live-poll",
                "providerBucket": "runtime"
            }
        ]
    }
}
