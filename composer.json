{
    "name": "capell-app/widget-live-poll",
    "description": "Transactional privacy-conscious live poll widget for Capell.",
    "type": "library",
    "license": "proprietary",
    "require": {
        "php": "^8.4",
        "capell-app/admin": "^0.0.2 || 0.0.x-dev",
        "capell-app/core": "^0.0.2 || 0.0.x-dev",
        "capell-app/frontend": "^0.0.2 || 0.0.x-dev",
        "capell-app/layout-builder": "^0.0.2 || 0.0.x-dev",
        "laravel/framework": "^12.0",
        "lorisleiva/laravel-actions": "^2.8",
        "spatie/laravel-package-tools": "^1.0"
    },
    "autoload": {
        "psr-4": {
            "Capell\\WidgetLivePoll\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Capell\\WidgetLivePoll\\Providers\\WidgetLivePollServiceProvider"
            ]
        },
        "branch-alias": {
            "dev-main": "0.0.x-dev"
        }
    },
    "config": {
        "sort-packages": true
    },
    "prefer-stable": true
}
